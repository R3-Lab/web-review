# Copy to `.env.local` (`cp .env.example .env.local`) and edit the two
# secrets below if you want anything other than these development
# placeholders. See README.md for the full run sequence.

# Points at the Postgres started by `docker compose up -d` (see
# docker-compose.yml — host port 55434, db/user/password all `r3wr`).
# `next build` loads this module-eagerly (see drizzle/client.ts), so
# DATABASE_URL must be set for `pnpm build`, not just `pnpm dev`.
DATABASE_URL=postgres://r3wr:r3wr@localhost:55434/r3wr_demo

# Shared password reviewers enter to unlock the overlay. Change this to
# anything you like for local use.
REVIEW_PASSWORD=review-me

# Signs the access cookie minted after a successful unlock (see
# packages/web-review/src/server/access.ts). Any non-empty string works
# locally; use a long random value in a real deployment.
REVIEW_SECRET=dev-only-secret-change-me-before-deploying-anywhere-real

# Build-time switch that mounts the overlay at all (see
# packages/web-review/src/next/client.tsx) — unset or set to anything other
# than "1" to build the app with the overlay completely absent.
NEXT_PUBLIC_REVIEW_ENABLED=1
