{
  "name": "next-demo",
  "private": true,
  "version": "0.0.0",
  "description": "Example Next.js App Router app demonstrating @r3lab/web-review wired to a real Postgres database via Drizzle.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:apply": "node scripts/apply-sql.mjs",
    "e2e": "bash scripts/e2e.sh",
    "e2e:build:enabled": "NEXT_DIST_DIR=.next-e2e-enabled next build",
    "e2e:start:enabled": "NEXT_DIST_DIR=.next-e2e-enabled next start -p 32111",
    "e2e:build:disabled": "NEXT_DIST_DIR=.next-e2e-disabled next build",
    "e2e:start:disabled": "NEXT_DIST_DIR=.next-e2e-disabled next start -p 32112"
  },
  "dependencies": {
    "@r3lab/web-review": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  }
}
